"""
Smart Thermostat system
"""

class SmartThermostat:
    NUM_CHANGES = 0
    def __init__(self,device_id:str,temperature:float,current_temperature:float):
        if not device_id:
            raise ValueError("Can't be empty string!")
        self.__device_id = device_id

        if not isinstance(temperature,(float,int)):
            raise TypeError(f"Temp must not be type: {type(temperature)}")
        elif  temperature < 16 or temperature > 30:
            raise ValueError
        else:
            self._temperature = temperature
        

        self._current_temperature = current_temperature # protected attribute, read only from external 
    def update_sensor_reading(self,value):
        if not isinstance(value,(int,float)):
            raise TypeError
        elif value < 16 or value >30:
            raise ValueError
        else:
            self._current_temperature = value 

    @classmethod
    def num_change(cls):
        return cls.NUM_CHANGES
    @property
    def current_temperature(self):
        return self._current_temperature

    @property
    def temperature(self):
        return self._temperature

    @temperature.setter
    def temperature(self,new):
        if not isinstance(new,(int,float)):
            raise TypeError
        elif new <= 16 or new >= 30:
            raise ValueError
        elif new != self._temperature:
            self._temperature = new
            self.num_change() + 1
        else:
            self._temperature = new


    @property
    def get_id(self):
        return self.__device_id


thermo1 = SmartThermostat('01_term',19,17)
print(thermo1.get_id)
print(thermo1.temperature)
print(thermo1._current_temperature)
thermo1.temperature = 19
print(thermo1.temperature)
thermo1.update_sensor_reading(22.5)
print(thermo1.current_temperature)
print(thermo1.NUM_CHANGES)
